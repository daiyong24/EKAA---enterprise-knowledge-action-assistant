# Local-only credentials for the isolated Stage 21 demo Compose project.
# Copy this file to .env.stage21. Do not reuse these values in a shared environment.
POSTGRES_DB=ekaa_stage21
POSTGRES_USER=ekaa_stage21
POSTGRES_PASSWORD=stage21-local-only-change-me

# The script overrides these two values for the selected local port and model.
EKAA_API_PORT=8021
EKAA_LLM_MODEL=qwen2.5:3b
EKAA_LLM_BASE_URL=http://host.docker.internal:11434/v1
EKAA_LLM_API_KEY=ollama-local
