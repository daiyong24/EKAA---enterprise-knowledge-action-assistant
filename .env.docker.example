# Copy to .env (never commit the resulting file) before running Compose.
POSTGRES_DB=ekaa
POSTGRES_USER=ekaa
POSTGRES_PASSWORD=replace-with-a-local-only-password
EKAA_ENVIRONMENT=development
EKAA_DEBUG=false
EKAA_RUN_MIGRATIONS=true
EKAA_API_PORT=8000
# Optional local Ollama; keep disabled unless the host model is running.
EKAA_LLM_ENABLED=false
EKAA_LLM_BASE_URL=http://host.docker.internal:11434/v1
EKAA_LLM_API_KEY=ollama-local
EKAA_LLM_MODEL=qwen3:4b
