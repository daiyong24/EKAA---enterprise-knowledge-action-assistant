# Runtime environment. Copy to .env; never commit the resulting file.
EKAA_ENVIRONMENT=development
EKAA_LOG_LEVEL=INFO
EKAA_APP_NAME=EKAA API
EKAA_DEBUG=false
# Stage 1 LLM is disabled by default. Never commit a real API key.
EKAA_LLM_ENABLED=false
EKAA_LLM_PROVIDER=openai_compatible
EKAA_LLM_BASE_URL=https://api.openai.com/v1
# EKAA_LLM_API_KEY=
# EKAA_LLM_MODEL=
EKAA_LLM_TIMEOUT_SECONDS=15
EKAA_LLM_MAX_RETRIES=2
EKAA_LLM_RETRY_DELAY_SECONDS=0.1
# Stage 8 synthetic local-generation evaluation is opt-in and accepts only the
# loopback Ollama OpenAI-compatible endpoint. Keep this disabled by default. Ollama
# ignores the marker key, but EKAA's provider boundary requires a non-empty value.
# EKAA_LLM_ENABLED=true
# EKAA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EKAA_LLM_API_KEY=ollama-local
# EKAA_LLM_MODEL=qwen3:4b
# Stage 2 document metadata and chunks. Apply Alembic migrations before uploading.
# Use a PostgreSQL URL in shared environments, for example postgresql+psycopg://...
EKAA_DATABASE_URL=sqlite:///./ekaa.db
EKAA_INGESTION_MAX_FILE_SIZE_BYTES=10485760
EKAA_INGESTION_MAX_REQUEST_SIZE_BYTES=11534336
EKAA_INGESTION_MAX_PDF_PAGES=200
EKAA_INGESTION_MAX_EXTRACTED_CHARACTERS=2000000
EKAA_INGESTION_CHUNK_SIZE_CHARACTERS=1200
EKAA_INGESTION_CHUNK_OVERLAP_CHARACTERS=200
# Stage 3 semantic retrieval. This deterministic provider is local-only and never
# sends chunk text to a third party. Set ENABLED only with PostgreSQL + pgvector.
EKAA_EMBEDDING_ENABLED=false
EKAA_EMBEDDING_PROVIDER=deterministic
EKAA_EMBEDDING_MODEL=deterministic-hash-v1
EKAA_EMBEDDING_DIMENSIONS=64
EKAA_EMBEDDING_BATCH_SIZE=32
EKAA_RETRIEVAL_DEFAULT_TOP_K=5
EKAA_RETRIEVAL_MAX_TOP_K=20
# Stage 6 hybrid retrieval uses PostgreSQL full-text search plus semantic candidates.
# It is off by default; enable only with the Stage 6 migration on PostgreSQL.
EKAA_HYBRID_RETRIEVAL_ENABLED=false
EKAA_HYBRID_SEMANTIC_CANDIDATE_COUNT=12
EKAA_HYBRID_LEXICAL_CANDIDATE_COUNT=12
EKAA_HYBRID_RRF_RANK_CONSTANT=60
# Stage 7 reranks already-qualified hybrid candidates only for RAG final context
# selection. It is local deterministic overlap scoring by default and never changes
# evidence confidence, source ownership, or citation validation.
EKAA_RERANKING_ENABLED=false
EKAA_RERANKING_PROVIDER=deterministic_overlap
EKAA_RERANKING_CANDIDATE_COUNT=12
EKAA_RERANKING_TIMEOUT_SECONDS=1
# Stage 4 basic RAG remains disabled until both PostgreSQL/pgvector retrieval and a
# compatible LLM provider have been explicitly configured. Only synthetic/public
# content is permitted before Stage 9 authorization.
EKAA_RAG_ENABLED=false
EKAA_RAG_RETRIEVAL_TOP_K=5
EKAA_RAG_MIN_EVIDENCE_SCORE=0.2
EKAA_RAG_MIN_EVIDENCE_SOURCES=1
EKAA_RAG_MAX_SOURCES=5
EKAA_RAG_MAX_CONTEXT_CHARACTERS=6000
EKAA_RAG_MAX_CONTEXT_TOKENS=1500
# Stage 5 validates provider-proposed claim/source links only against exact chunks
# selected for the request, and creates public citation IDs and excerpts server-side.
EKAA_CITATION_MAX_CLAIMS=10
EKAA_CITATION_MAX_CLAIM_CHARACTERS=1000
EKAA_CITATION_MAX_EXCERPT_CHARACTERS=500
