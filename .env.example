# Runtime environment. Copy to .env; never commit the resulting file.
EKAA_ENVIRONMENT=development
EKAA_LOG_LEVEL=INFO
EKAA_APP_NAME=EKAA API
EKAA_DEBUG=false
# Stage 1 LLM is disabled by default. Never commit a real API key.
EKAA_LLM_ENABLED=false
EKAA_LLM_PROVIDER=openai_compatible
EKAA_LLM_BASE_URL=https://api.openai.com/v1
# EKAA_LLM_API_KEY=
# EKAA_LLM_MODEL=
EKAA_LLM_TIMEOUT_SECONDS=15
EKAA_LLM_MAX_RETRIES=2
EKAA_LLM_RETRY_DELAY_SECONDS=0.1
